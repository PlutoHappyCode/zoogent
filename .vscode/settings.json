{
  // 用项目的 .venv 解释器，Pylance 才能找到 lark_oapi / openai 等依赖
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // agentRunner 是子目录里的包根，让 Pylance 能解析 import core / channels
  "python.analysis.extraPaths": ["${workspaceFolder}/agentRunner"],
  "python.terminal.activateEnvironment": true
}
